DEVICE=cpu
CONFIG_PATH=/app/config/config.yaml
TRANSFORMERS_CACHE=/app/models/transformers
HF_HOME=/app/models/huggingface
FLASK_ENV=development

# Simulatore ROS (docker compose --profile sim up ui cobot-sim)
# COBOT_SERVICE_URL=http://cobot-sim:5001
# SIM_SERVICE_URL=http://cobot-sim:8080
SIM_SPEED=1
# quota iniziale (m) del piano di contatto; vuoto = nessuno. Si cambia dalla UI (pannello Simulator)
SIM_CONTACT_Z=
# MoveIt pianifica dallo stato del simulatore invece che dal proprio fake hardware
# ROBOT_STATE_URL=http://cobot-sim:8090/state
